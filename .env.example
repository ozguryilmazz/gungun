# ─────────────────────────────────────────────────────────────
# gundemci.org — ortam değişkenleri ŞABLONU
# Kopyala:  copy .env.example .env   (Windows)  |  cp .env.example .env
# .env dosyası Git'e GÖNDERİLMEZ. Bu dosyaya gerçek değer yazma.
# ─────────────────────────────────────────────────────────────

# Ortam: development | test | staging | production
NODE_ENV=development

# ── PostgreSQL (infra/docker-compose.yml bu değerleri kullanır) ──
POSTGRES_DB=gundemci
POSTGRES_USER=gundemci
# Güçlü ve rastgele bir şifre belirle (örn. 32+ karakter)
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
# POSTGRES_PASSWORD değiştirirsen buradaki şifreyi de değiştir
DATABASE_URL=postgresql://gundemci:change-me@127.0.0.1:5432/gundemci

# ── Uygulama adresleri (lokal) ──
WEB_ORIGIN=http://localhost:3000
API_HOST=127.0.0.1
API_PORT=4000
# Web uygulamasının sunucu tarafında API'ye eriştiği adres (tarayıcıya gönderilmez)
API_INTERNAL_URL=http://127.0.0.1:4000

# ── API ──
# info | debug | warn | error | silent
LOG_LEVEL=info
# Bellek içi önbellek süresi (saniye)
CACHE_TTL_SECONDS=30
# IP başına dakikadaki en fazla istek
RATE_LIMIT_MAX=120
# Rate limit'ten muaf IP'ler (virgülle). API'yi sunucu tarafında çağıran web sunucusu
# aynı bilgisayardaysa 127.0.0.1 olarak görünür.
RATE_LIMIT_ALLOWLIST=127.0.0.1,::1
# Yalnızca reverse proxy arkasında true yapın (aksi halde IP sahteciliğine açık)
TRUST_PROXY=false

# ── Güvenlik ──
# Oturum çerezi imzalama anahtarı — en az 64 rastgele karakter
# Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ── Veri modu ──
# true: pnpm db:seed örnek konuları (is_mock=true) yükler, arayüzde "ÖRNEK VERİ" şeridi görünür
# false: pnpm db:seed mevcut örnek verileri siler; gerçek veriye dokunmaz
USE_MOCK_DATA=true

# ── YouTube Data API v3 (Türkiye trend videoları) ──
# Google Cloud Console → API anahtarı; yalnızca "YouTube Data API v3" ile kısıtla.
# Yalnızca worker kullanır; tarayıcıya ve loglara gitmez. Boşsa YouTube bölümü "veri yok" gösterir.
YOUTUBE_API_KEY=

# ── AI (MVP'de kapalı) ──
AI_SUMMARY_ENABLED=false
AI_API_KEY=
