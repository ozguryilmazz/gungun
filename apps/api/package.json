{
  "name": "@gundemci/api",
  "version": "0.0.0",
  "private": true,
  "description": "gundemci.org backend API (Fastify)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "worker": "tsx src/worker.ts",
    "fetch:once": "tsx src/cli/fetch-once.ts",
    "providers": "tsx src/cli/providers.ts",
    "feed:inspect": "tsx src/cli/inspect-feed.ts",
    "topics:build": "tsx src/cli/build-topics.ts"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@gundemci/db": "workspace:*",
    "@gundemci/shared": "workspace:*",
    "drizzle-orm": "0.45.3",
    "fast-xml-parser": "5.11.2",
    "fastify": "5.12.5",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@gundemci/config": "workspace:*",
    "@types/node": "24.19.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
