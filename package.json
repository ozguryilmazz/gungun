{
  "name": "gundemci",
  "version": "0.0.0",
  "private": true,
  "description": "gundemci.org — Türkiye internet gündemi analiz platformu",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --no-bail --filter @gundemci/web --filter @gundemci/api dev",
    "dev:web": "pnpm --filter @gundemci/web dev",
    "dev:api": "pnpm --filter @gundemci/api dev",
    "build": "pnpm --filter @gundemci/web build",
    "start": "pnpm --filter @gundemci/web start",
    "start:api": "pnpm --filter @gundemci/api start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d",
    "db:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "db:logs": "docker compose --env-file .env -f infra/docker-compose.yml logs -f postgres",
    "db:generate": "pnpm --filter @gundemci/db generate",
    "db:migrate": "pnpm --filter @gundemci/db migrate",
    "db:seed": "pnpm --filter @gundemci/db seed",
    "worker": "pnpm --filter @gundemci/api worker",
    "fetch:once": "pnpm --filter @gundemci/api fetch:once",
    "providers": "pnpm --filter @gundemci/api providers",
    "feed:inspect": "pnpm --filter @gundemci/api feed:inspect"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gundemci/config": "workspace:*",
    "@next/eslint-plugin-next": "16.3.8",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
